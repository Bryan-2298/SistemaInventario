<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="997.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.sistemainventario.PreLoginController">
   <children>
      <AnchorPane prefHeight="50.0" prefWidth="997.0" style="-fx-background-color: #46AAE6;">
         <children>
            <Button fx:id="btnInicioSesion" layoutX="874.0" layoutY="10.0" mnemonicParsing="false" onAction="#irLogin" prefHeight="30.0" prefWidth="112.0" style="-fx-background-radius: 20; -fx-background-color: #2ECC71; -fx-cursor: hand;" text="Iniciar Sesión">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <ImageView fitHeight="550.0" fitWidth="1000.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" style="-fx-opacity: 0.5;">
         <image>
            <Image url="@../../../imagenes/PublicidadLogin.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
