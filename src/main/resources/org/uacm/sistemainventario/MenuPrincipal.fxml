<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" fx:id="pnlPanelCentral" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.sistemainventario.MenuPrincipalController">
   <children>
      <AnchorPane prefHeight="55.0" prefWidth="1000.0" styleClass="header-bar">
         <children>
            <Button fx:id="btnCerrarSesion" layoutX="876.0" layoutY="12.0" mnemonicParsing="false" onAction="#volverLogin" prefHeight="32.0" prefWidth="110.0" styleClass="btn-cerrar-sesion" text="Cerrar Sesión" />
            <Label layoutX="47.0" layoutY="12.0" styleClass="header-titulo" text="&lt;Nombre del usuario o nombre de la tienda&gt;" />
         </children>
      </AnchorPane>
      <AnchorPane layoutY="55.0" prefHeight="545.0" prefWidth="260.0" styleClass="menu-lateral">
         <children>
            <Button fx:id="btnAgregar" layoutX="20.0" layoutY="198.0" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="+ Agregar Producto" />
            <Button fx:id="btnActualizar" layoutX="20.0" layoutY="244.0" mnemonicParsing="false" onAction="#actualizarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="Actualizar Producto" />
            <Button fx:id="btnEliminar" layoutX="20.0" layoutY="290.0" mnemonicParsing="false" onAction="#eliminarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="Eliminar Producto" />
            <Button fx:id="btnConsultar" layoutX="20.0" layoutY="336.0" mnemonicParsing="false" onAction="#consultarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="Consultar Stocks" />
            <ImageView fx:id="imgImagenFondo" fitHeight="180.0" fitWidth="180.0" layoutX="47.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../imagenes/Logotipo.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="260.0" layoutY="55.0" prefHeight="545.0" prefWidth="740.0" styleClass="panel-contenido">
         <children>
            <Label layoutX="230.0" layoutY="200.0" styleClass="titulo-seccion" text="Bienvenido al Sistema" />
            <Label layoutX="210.0" layoutY="248.0" style="-fx-text-fill: #718096; -fx-font-size: 14px;" text="Selecciona una opcion del menu lateral (lado izquierdo) para comenzar." />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
