<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="pnlPanelCentral" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.sistemainventario.MenuPrincipalController">
   <children>
      <AnchorPane prefHeight="50.0" prefWidth="1000.0" style="-fx-background-color: #46AAE6; -fx-border-color: black; -fx-border-image-width: 2;">
         <children>
            <Button fx:id="btnCerrarSesion" layoutX="884.0" layoutY="13.0" mnemonicParsing="false" onAction="#volverLogin" prefHeight="25.0" prefWidth="99.0" style="-fx-background-color: #EF4444; -fx-background-radius: 20; -fx-cursor: hand;" text="Cerrar Sesión" textFill="#f8f8f8">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Label layoutX="47.0" layoutY="12.0" text="&lt;Nombre del usuario o nombre de la tienda&gt;">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane layoutY="50.0" prefHeight="550.0" prefWidth="300.0" style="-fx-background-color: #B6E1E0; -fx-border-color: black; -fx-border-image-width: 2; -fx-background-radius: 0;">
         <children>
            <Button fx:id="btnAgregar" layoutX="91.0" layoutY="281.0" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="25.0" prefWidth="130.0" style="-fx-background-radius: 20; -fx-cursor: hand;" text="Agregar Producto">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnActualizar" layoutX="91.0" layoutY="336.0" mnemonicParsing="false" onAction="#actualizarProducto" prefHeight="25.0" prefWidth="130.0" style="-fx-background-radius: 20; -fx-cursor: hand;" text="Actualizar Producto">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnEliminar" layoutX="91.0" layoutY="392.0" mnemonicParsing="false" onAction="#eliminarProducto" prefHeight="25.0" prefWidth="130.0" style="-fx-background-radius: 20; -fx-cursor: hand;" text="Eliminar Producto">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnConsultar" layoutX="91.0" layoutY="447.0" mnemonicParsing="false" onAction="#consultarProducto" prefHeight="25.0" prefWidth="130.0" style="-fx-background-radius: 20; -fx-cursor: hand;" text="Consultar Stocks">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <ImageView fx:id="imgImagenFondo" fitHeight="223.0" fitWidth="231.0" layoutX="56.0" layoutY="28.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../imagenes/Logotipo.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
