<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="pnlPanelCentral" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.sistemainventario.ActualizarProductoController">

   <children>

      <!-- HEADER -->
      <AnchorPane prefHeight="55.0" prefWidth="1000.0" styleClass="header-bar">
         <children>

            <Label layoutX="47.0" layoutY="12.0" styleClass="header-titulo" text="Sistema de Inventario - Actualizar Producto" />
            <Button fx:id="btnCerrarSesion" layoutX="876.0" layoutY="12.0" onAction="#volverLogin" prefHeight="32.0" prefWidth="110.0" styleClass="btn-cerrar-sesion" text="Cerrar Sesión" />
         </children>
      </AnchorPane>

      <!-- MENU LATERAL -->
      <AnchorPane layoutY="55.0" prefHeight="545.0" prefWidth="260.0" styleClass="menu-lateral">
         <children>
            
            <ImageView fx:id="imgImagenFondo" fitHeight="180.0" fitWidth="180.0" layoutX="47.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../imagenes/Logotipo.png" />
               </image>
            </ImageView>
            <Label layoutX="60.0" layoutY="175.0" text="Menu Principal" />
            <Button fx:id="btnAgregar" layoutX="20.0" layoutY="198.0" onAction="#agregarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="+ Agregar Producto" />

            <Button fx:id="btnActualizar" layoutX="20.0" layoutY="244.0" onAction="#actualizarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton-activo" text="Actualizar Producto" />

            <Button fx:id="btnEliminar" layoutX="20.0" layoutY="290.0" onAction="#eliminarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="Eliminar Producto" />

            <Button fx:id="btnConsultar" layoutX="20.0" layoutY="336.0" onAction="#consultarProducto" prefHeight="38.0" prefWidth="220.0" styleClass="menu-boton" text="Consultar Stocks" />
         </children>
      </AnchorPane>

      <!-- PANEL PRINCIPAL -->
      <AnchorPane layoutX="260.0" layoutY="55.0" prefHeight="545.0" prefWidth="740.0" styleClass="panel-contenido">
         <children>

            <!-- TITULO -->
            <Label layoutX="40.0" layoutY="30.0" styleClass="titulo-seccion" text="Actualizar Producto" />
            <AnchorPane layoutX="40.0" layoutY="62.0" prefHeight="2.0" prefWidth="660.0" />

            <!-- BUSQUEDA -->
            <Label layoutX="40.0" layoutY="80.0" styleClass="campo-label" text="Buscar producto por nombre:" />

            <TextField fx:id="txtBuscar" layoutX="40.0" layoutY="110.0" prefHeight="34.0" prefWidth="520.0" promptText="Ingresa nombre del producto" />

                  <Button layoutX="576.0" layoutY="110.0" onAction="#buscarProducto" prefHeight="34.0" prefWidth="100.0" styleClass="btn-secundario" text="Buscar" />
            <AnchorPane layoutX="50.0" layoutY="72.0" prefHeight="2.0" prefWidth="660.0" />

            <!-- Campos del formulario -->
            <Label layoutX="40.0" layoutY="175.0" styleClass="campo-label" text="Nombre:" />
            <TextField fx:id="txtNombre" layoutX="40.0" layoutY="197.0" prefHeight="34.0" prefWidth="300.0" />

            <Label layoutX="380.0" layoutY="175.0" styleClass="campo-label" text="Categoría:" />
            <ChoiceBox fx:id="chCategoria" layoutX="380.0" layoutY="197.0" prefHeight="34.0" prefWidth="300.0" styleClass="choise-box" />

            <Label layoutX="40.0" layoutY="245.0" styleClass="campo-label" text="Precio(MXN):" />
            <TextField fx:id="txtPrecio" layoutX="40.0" layoutY="277.0" prefHeight="34.0" prefWidth="300.0" />

            <Label layoutX="380.0" layoutY="255.0" styleClass="campo-label" text="Cantidad:" />
            <TextField fx:id="txtCantidad" layoutX="380.0" layoutY="277.0" prefHeight="34.0" prefWidth="300.0" />

            <!-- NUEVO: Campo Fecha -->
            <Label layoutX="40.0" layoutY="325.0" styleClass="campo-label" text="Fecha Ingreso:" />
            <DatePicker fx:id="dpFecha" layoutX="40.0" layoutY="357.0" prefHeight="34.0" prefWidth="300.0" styleClass="date-picker" />

            <!-- BOTON ACTUALIZAR -->
            <Button layoutX="406.0" layoutY="357.0" onAction="#actualizarProducto" prefHeight="35.0" prefWidth="116.0" styleClass="btn-primario" text="Actualizar" />
            <Button layoutX="560.0" layoutY="357.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="96.0" styleClass="btn-peligro" text="Eliminar" />

         </children>
      </AnchorPane>

   </children>
</AnchorPane>
